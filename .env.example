# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpostgrespassword
POSTGRES_DB=cohabio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:yourpostgrespassword@localhost:5432/cohabio

# Official CoHabio SMTP Email Sender Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mail.cohabio@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM_EMAIL=mail.cohabio@gmail.com
SMTP_FROM_NAME=CoHabio

# Google OAuth Credentials
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Application Security & JWT
SECRET_KEY=super_secret_cohabio_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Relocation Assistant
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Mobile Client API Host Configuration
# For Android Emulator: http://10.0.2.2:8000/api/v1
# For Physical Phone on same Wi-Fi: http://192.168.x.x:8000/api/v1
# For Local USB reverse forwarding: http://127.0.0.1:8000/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1
